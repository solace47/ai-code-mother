# 开发环境配置模版文件
# 使用说明：
# 1. 复制此文件并重命名为 application-dev.yml
# 2. 将下面的占位符替换为实际的配置值
# 3. application-dev.yml 已加入 .gitignore，不会被提交到版本控制

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3307/ai_code_mother  # 修改为你的数据库地址和端口
    username: root  # 修改为你的数据库用户名
    password: your-database-password  # 修改为你的数据库密码
  # redis
  data:
    redis:
      host: 127.0.0.1  # 修改为你的 Redis 地址
      port: 6379  # 修改为你的 Redis 端口
      password:  # 如果 Redis 设置了密码，在此填写
      database: 0
  # 邮件配置
  mail:
    host: smtp.example.com
    port: 587
    username: your-email@example.com
    password: your-email-password # 填写你的stmp授权码
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true

# 添加 COS 对象存储配置（需要从腾讯云获取）
cos:
  client:
    host: your-custom-domain.com  # 修改为你的 COS 自定义域名
    secretId: your-secret-id  # 修改为你的腾讯云 Secret ID
    secretKey: your-secret-key  # 修改为你的腾讯云 Secret Key
    region: ap-shanghai  # 修改为你的 COS 区域
    bucket: your-bucket-name  # 修改为你的 COS 存储桶名称

# Pexels 图片搜索配置
# 获取地址：https://www.pexels.com/api/
pexels:
  api-key: your-pexels-api-key  # 修改为你的 Pexels API Key

# Pixabay 插画搜索配置
# 获取地址：https://pixabay.com/api/docs/
pixabay:
  api-key: your-pixabay-api-key  # 修改为你的 Pixabay API Key

# 阿里云 DashScope 配置
# 获取地址：https://dashscope.console.aliyun.com/
dashscope:
  api-key: your-dashscope-api-key  # 修改为你的 DashScope API Key
  image-model: wan2.2-t2i-flash

# AI 模型配置
langchain4j:
  open-ai:
    # 推理 AI 模型配置（用于复杂的推理任务）
    # DeepSeek 获取地址：https://platform.deepseek.com/
    reasoning-streaming-chat-model:
      base-url: https://api.deepseek.com
      api-key: your-deepseek-api-key  # 修改为你的 DeepSeek API Key
      model-name: deepseek-reasoner
      max-tokens: 32768
      temperature: 0.1
      log-requests: true
      log-responses: true
    # 智能路由 AI 模型配置（用于简单的分类任务）
    # 阿里云百炼平台：https://bailian.console.aliyun.com/
    routing-chat-model:
      base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
      api-key: your-qwen-api-key  # 修改为你的通义千问 API Key
      model-name: qwen-turbo
      max-tokens: 100
      log-requests: true
      log-responses: true

